# MERIDIAN — live signal adapters.
# Every key below is OPTIONAL. With none set, the app runs on the curated
# dataset and every source reports `unconfigured` in the Signal Integrity panel.
# Add a key and that adapter switches to `live` on the next sync — no code change.

# PredictHQ — event demand intelligence (predicthq.com)
PREDICTHQ_TOKEN=

# Ticketmaster Discovery API (developer.ticketmaster.com)
TICKETMASTER_API_KEY=

# X / Twitter API v2 — recent search counts for mention volume
X_BEARER_TOKEN=

# SerpAPI — Google Trends relative search interest (serpapi.com)
SERPAPI_KEY=

# Amadeus — hotel + air availability pressure (developers.amadeus.com)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
